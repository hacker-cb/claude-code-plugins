{
  "name": "hacker-cb-plugins-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev tooling (node --test + tsc type-check) for the hacker-cb-plugins marketplace plugin engines.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
