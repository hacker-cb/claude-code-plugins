#!/usr/bin/env bash
[ -n "${STUB_MARKER_FILE:-}" ] && : > "$STUB_MARKER_FILE"
env=${STUB_ENVELOPE:-}
ask() { [ -n "$env" ] && jq -r "$1 // empty" "$env"; }
fail() { echo "${1:-fatal: stub git refused}" >&2; exit "${2:-1}"; }
# A remote answers differently before and after an act reaches it, and a case about a push
# nobody waited out is exactly that difference. The count lives beside the marker, under the
# envelope's own name: the runner hands each case a fresh work directory and one envelope, so
# no two cases share a file and nothing survives a run.
reads() {
  [ -n "${STUB_MARKER_FILE:-}" ] || { echo 0; return; }
  f="$STUB_MARKER_FILE.$(basename "${env:-none}" .json).$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_')"
  n=$(cat "$f" 2>/dev/null || echo 0)
  n=$((n + 1)); printf '%s\n' "$n" > "$f"; printf '%s\n' "$n"
}

case "$1 $2" in
  "rev-parse --git-dir") echo ".git"; exit 0 ;;
  "rev-parse --show-toplevel")
    v=$(ask '.here'); [ -z "$v" ] && v=/tmp/example-checkout
    case "$v" in fail) fail "fatal: not a git repository" 128 ;; esac
    printf '%s\n' "$v"; exit 0 ;;
  "symbolic-ref --short")
    # `head_empty` is the git that exits 0 saying nothing — rarer than the refusal, and
    # the one an exit-status check alone reads as a branch named the empty string.
    case "$(ask '.head_empty')" in yes) exit 0 ;; esac
    v=$(ask '.head'); [ -z "$v" ] && exit 1
    printf '%s\n' "$v"; exit 0 ;;
  "branch -m")
    # Keyed by the name asked for: the rename back and the rename forward are two
    # decisions in one run, and a case needs to refuse one while allowing the other.
    case "$(ask ".rename[\"$3\"] // .rename_default")" in
      fail) fail "fatal: a branch named '$3' already exists" 128 ;;
    esac
    exit 0 ;;
  "rev-parse --verify")
    # `$4` is `<rev>^{commit}`. Two questions arrive here: whether the base tracking ref
    # is in this checkout at all, and whether a remote's tip is an object it carries.
    case "$4" in
      refs/remotes/*)
        # A tracking ref a fetch just wrote, where a case needs it to hold something other
        # than this branch's tip — the remote having moved between the read and the fetch.
        t=$(ask ".object_tip[\"${4%^*}\"]")
        [ -n "$t" ] && { printf '%s\n' "$t"; exit 0; }
        case "$(ask '.base_present')" in no) exit 1 ;; esac ;;
      *) case "$(ask ".object[\"${4%^*}\"] // .object_default")" in no) exit 1 ;; esac ;;
    esac
    echo "cafe"; exit 0 ;;
  "ls-remote --heads")
    # The ref is the LAST argument and the repository the one before it: what stands there
    # is the push url wherever one differs from the fetch url, and a case pins which was
    # asked. Reading either by position from the front breaks the moment a flag moves.
    for ls_ref; do :; done
    ls_repo=$4
    want_repo=$(ask '.expect_ls_repo')
    [ -n "$want_repo" ] && [ "$want_repo" != "$ls_repo" ] \
      && fail "stub git: ls-remote asked $ls_repo, not $want_repo" 3
    v=$(ask ".ls_remote[\"$ls_ref\"] // .ls_remote_default")
    later=$(ask ".ls_remote_later[\"$ls_ref\"]")
    if [ -n "$later" ]; then
      lag=$(ask '.ls_remote_lag'); [ -z "$lag" ] && lag=1
      [ "$(reads "$ls_ref")" -gt "$lag" ] && v=$later
    fi
    case "$v" in
      ""|silent) fail "fatal: could not read from remote repository" 128 ;;
      absent) exit 0 ;;
      *) printf '%s\n' "$v"; exit 0 ;;
    esac ;;
  "merge-base --is-ancestor")
    # Four questions, told apart by the PAIR rather than by one side: two of them measure
    # against the same `refs/heads/<ships>` and a dispatch on that alone answers one with
    # the other's envelope key.
    case "$3:$4" in
      refs/remotes/*:*) k=fast_forward ;;   # the published tip, already in this branch
      *:HEAD)           k=stood_on ;;       # an old name's tip, in this branch's history
      *:refs/remotes/*) k=in_base ;;        # that tip, already in the base
      *)                k=ship_stood_on ;;  # the published tip of the name being pushed
    esac
    case "$(ask ".$k")" in yes) exit 0 ;; *) exit 1 ;; esac ;;
  "reflog show")
    v=$(ask '.reflog')
    case "$v" in ""|fail) fail "fatal: no reflog for that ref" 128 ;; esac
    printf '%s\n' "$v"; exit 0 ;;
  "worktree list")
    case "$(ask '.worktrees_fail')" in yes) fail "fatal: could not list worktrees" 128 ;; esac
    v=$(ask '.worktrees')
    # By default this checkout alone, standing on the branch the envelope says HEAD is on.
    # A listing that disagreed with HEAD would make every case test a contradiction.
    [ -z "$v" ] && v="worktree /tmp/example-checkout
branch refs/heads/$(ask '.head')"

    # The envelope holds the line form; `-z` is the same shape with NUL where the
    # newlines are, which is what git prints.
    for a in "$@"; do [ "$a" = "-z" ] || continue
      printf '%s' "$v" | tr '\n' '\0'; exit 0
    done
    printf '%s\n' "$v"; exit 0 ;;
esac
case "$1 $2" in
  "remote get-url")
    # The url that RECEIVES pushes, which is what says WHICH repository a deletion here
    # would land in — a different question from the one `gh` answers for. Without
    # `--push` it is the fetch url, the same one unless a case says otherwise; `push_url`
    # may hold several, one per line, and only `--all` prints past the first.
    push=0 all=0
    for a in "$@"; do case "$a" in --push) push=1 ;; --all) all=1 ;; esac; done
    if [ "$push" = 1 ]; then v=$(ask '.push_url'); else v=$(ask '.fetch_url // .push_url'); fi
    [ -z "$v" ] && v=https://forge.example/example-org/example-repo.git
    case "$v" in fail) fail "fatal: no such remote" 128 ;; esac
    if [ "$all" = 1 ]; then printf '%s\n' "$v"; else printf '%s\n' "$v" | head -1; fi
    exit 0 ;;
esac
case "$1" in
  fetch)
    # A remote that REWOUND, which is the case the leading `+` is for: without it git
    # refuses the tracking-ref update as non-fast-forward, and the lease below then rests
    # on a ref that was never refreshed.
    case "$3" in +*) ;; *) fail "! [rejected] $3 (non-fast-forward)" 1 ;; esac
    case "$(ask '.fetch')" in fail) fail "fatal: couldn't find remote ref" 128 ;; esac
    exit 0 ;;
  config)
    # What `push -u` writes, written here where a push that was killed never got to it.
    case "$(ask '.config')" in fail) fail "error: could not lock config file" 255 ;; esac
    exit 0 ;;
  push)
    case "$*" in
      *--delete*) case "$(ask '.delete')" in
          fail) fail "remote: refusing to delete the ref" 1 ;;
          # Never answering, which is the case this suite is otherwise blind to: the runner
          # kills it on its own budget. `exec` so the kill lands on the sleep rather than
          # leaving it behind the shell that started it.
          hang) v=$(ask '.delete_says'); [ -n "$v" ] && printf '%s\n' "$v" >&2; exec sleep 30 ;;
        esac ;;
      *)
        # A tag of the same name, which is what the full refname on the source side is
        # for: a bare branch name matches both and git refuses rather than choosing.
        case "$*" in *refs/heads/*:refs/heads/*) ;;
          *) fail "error: src refspec matches more than one" 1 ;; esac
        case "$(ask '.push')" in
          fail) fail "! [rejected] stale info" 1 ;;
          # Exit 128, where a refusal exits 1: the transport died, so the remote's verdict
          # — if it ever reached one — never came back.
          hangup) fail "fatal: the remote end hung up unexpectedly" 128 ;;
          hang) v=$(ask '.push_says'); [ -n "$v" ] && printf '%s\n' "$v" >&2; exec sleep 30 ;;
        esac ;;
    esac
    exit 0 ;;
esac
echo "stub git: no envelope answer for: $*" >&2; exit 3
