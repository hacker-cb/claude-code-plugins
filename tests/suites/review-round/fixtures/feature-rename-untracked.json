{
  "steps": [
    {
      "branch": "feature",
      "from": "base"
    },
    {
      "on": "feature",
      "write": {
        "lib/helpers.sh": "say() { printf '%s\\n' \"$1\"; }\nhush() { :; }\n",
        "quo\"te.sh": "echo quoted\n"
      },
      "remove": [
        "lib/util.sh"
      ]
    },
    {
      "untracked": {
        "lib/util.sh": "restored\n"
      }
    }
  ]
}