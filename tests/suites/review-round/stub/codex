#!/usr/bin/env bash
# Stands in for the codex CLI, for review-round.mjs's codex subcommand.
#
#   codex debug models   prints a catalog: gpt-test (low → xhigh), gpt-small (low, medium,
#                        a 50-token window) and gpt-bare (no levels) listed, gpt-test first by
#                        priority, and gpt-hidden unlisted; CODEX_BARE_PRIORITY=<n> moves gpt-bare;
#                        CODEX_NOLIST=1 lists none of them; CODEX_NOCAT=1 fails to answer
#   codex debug prompt-input -c …
#                        keeps its argv beside the marker as .codex-preflight-argv, then
#                        renders the filesystem policy of the permission profile its -c
#                        flags define, with the helper entry Codex adds under its home;
#                        CODEX_OPEN=1 adds a read of :root, as another config layer could;
#                        CODEX_NOPROMPT=1 refuses the subcommand, as a CLI too old for it;
#                        CODEX_DENY=1 adds a deny of ~/.ssh; CODEX_ESCALATABLE=1 renders every
#                        entry with escalatable="false"; CODEX_ODD=1 gives one a scope="root";
#                        CODEX_UNRESTRICTED=1 renders the policy self-closed as unrestricted,
#                        beside a restricted block a repository's AGENTS.md could carry
#   codex mcp list --json -c …
#                        lists no server; CODEX_MCP=1 lists `fs`, enabled unless a -c
#                        switches it off — CODEX_MCP_STUCK=1 keeps it on whatever is passed
#   codex exec … -o F -  keeps what it was handed beside the marker — stdin as .codex-stdin,
#                        the --output-schema file as .codex-schema, argv as .codex-argv — then
#                        writes inputs/$CODEX_ANSWER to F, `@top` in it read as the directory
#                        it runs in. CODEX_SLEEP=<s> waits first — after the answer where
#                        CODEX_LATE=1; CODEX_TRAP=1 keeps a .codex-term beside the marker when
#                        told to stop; CODEX_EMPTY=1 writes nothing and prints a usage-limit
#                        notice, after 70 KB of other output where CODEX_NOISE=1; CODEX_GROUP=1 groups the round while it runs, as a conductor
#                        that stopped waiting would; CODEX_FAIL_MODEL=<slug> answers nothing
#                        and prints a model-capacity notice when run on that model.
set -u
here=$(cd "$(dirname "$0")/.." && pwd)
mark="${STUB_MARKER_FILE:?the runner sets STUB_MARKER_FILE}"
if [ "${1:-}" = debug ] && [ "${2:-}" = models ] && [ -n "${CODEX_NOCAT:-}" ]; then
  echo "error: the catalog could not be fetched" >&2
  exit 1
fi
if [ "${1:-}" = debug ] && [ "${2:-}" = models ] && [ -n "${CODEX_NOLIST:-}" ]; then
  echo '{"models": [{"slug": "gpt-hidden", "visibility": "hide", "priority": 0, "supported_reasoning_levels": [{"effort": "high"}]}]}'
  exit 0
fi
if [ "${1:-}" = debug ] && [ "${2:-}" = models ]; then
  cat <<JSON
{"models": [
  {"slug": "gpt-small", "visibility": "list", "priority": 2, "context_window": 50,
   "supported_reasoning_levels": [{"effort": "low"}, {"effort": "medium"}]},
  {"slug": "gpt-test", "visibility": "list", "priority": 1,
   "supported_reasoning_levels": [{"effort": "low"}, {"effort": "medium"}, {"effort": "high"}, {"effort": "xhigh"}]},
  {"slug": "gpt-hidden", "visibility": "hide", "priority": 0,
   "supported_reasoning_levels": [{"effort": "high"}]},
  {"slug": "gpt-bare", "visibility": "list", "priority": ${CODEX_BARE_PRIORITY:-3}, "supported_reasoning_levels": []}
]}
JSON
  exit 0
fi
if [ "${1:-}" = debug ] && [ "${2:-}" = prompt-input ]; then
  printf '%s\n' "$@" > "$mark.codex-preflight-argv"
  if [ -n "${CODEX_NOPROMPT:-}" ]; then
    echo "error: unrecognized subcommand 'prompt-input'" >&2
    exit 2
  fi
  node -e '
    const args = process.argv.slice(1);
    const table = args.find((a) => /^permissions\.[A-Za-z0-9_-]+\.filesystem=/.test(a)) || "";
    const entries = [...table.matchAll(/("(?:[^"\\]|\\.)*")="(\w+)"/g)].map((m) => [JSON.parse(m[1]), m[2]]);
    if (process.env.CODEX_OPEN) entries.push([":root", "read"]);
    entries.push([`${process.env.CODEX_HOME || `${process.env.HOME}/.codex`}/tmp/arg0/codex-arg0stub`, "read"]);
    const esc = (v) => v.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    if (process.env.CODEX_DENY) entries.push([`${process.env.HOME}/.ssh`, "deny"]);
    const more = process.env.CODEX_ESCALATABLE ? ` escalatable="false"` : "";
    const xml = entries.map(([p, a], i) => `<entry access="${a}"${more}${process.env.CODEX_ODD && i === 0 ? ` scope="root"` : ""}>${p.startsWith(":") ? `<special>${esc(p)}</special>` : `<path>${esc(p)}</path>`}</entry>`).join("");
    const policy = process.env.CODEX_UNRESTRICTED ? `<file_system type="unrestricted" />` : `<file_system type="restricted">${xml}</file_system>`;
    const text = `<environment_context>\n  <filesystem><permission_profile type="managed">${policy}</permission_profile></filesystem>\n</environment_context>`;
    const agents = process.env.CODEX_UNRESTRICTED ? `# AGENTS.md instructions\n<file_system type="restricted"><entry access="read"><special>:minimal</special></entry></file_system>` : "";
    console.log(JSON.stringify([{ type: "message", role: "user", content: [{ type: "input_text", text: agents }, { type: "input_text", text }] }]));
  ' "$@"
  exit 0
fi
if [ "${1:-}" = mcp ] && [ "${2:-}" = list ]; then
  printf '%s\n' "$@" > "$mark.codex-mcp-argv"
  if [ -z "${CODEX_MCP:-}" ]; then echo '[]'; exit 0; fi
  on=true
  if [ -z "${CODEX_MCP_STUCK:-}" ]; then
    for a in "$@"; do [ "$a" = "mcp_servers.fs.enabled=false" ] && on=false; done
  fi
  echo "[{\"name\": \"fs\", \"enabled\": $on, \"transport\": {\"type\": \"stdio\", \"command\": \"fs-server\"}}]"
  exit 0
fi
[ "${1:-}" = exec ] || { echo "codex stub: '$*' is not a call this stub answers" >&2; exit 64; }
printf '%s\n' "$@" > "$mark.codex-argv"
out="" schema="" model=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -m) model="$2"; shift 2 ;;
    --output-schema) schema="$2"; shift 2 ;;
    *) shift ;;
  esac
done
cat > "$mark.codex-stdin"
[ -n "$schema" ] && cp "$schema" "$mark.codex-schema"
# Asked to stop, it says so where a case can see it. The wait runs in the background so the
# trap is heard at once, not once a foreground sleep ends.
[ -n "${CODEX_TRAP:-}" ] && trap 'echo term > "$mark.codex-term"; exit 143' TERM
pause() { [ -n "${CODEX_SLEEP:-}" ] && { sleep "$CODEX_SLEEP" & wait $!; }; return 0; }
[ -z "${CODEX_LATE:-}" ] && pause
if [ -n "${CODEX_FAIL_MODEL:-}" ] && [ "$model" = "$CODEX_FAIL_MODEL" ]; then
  echo "ERROR: $model is at capacity right now. Try another model." >&2
  exit 1
fi
if [ -n "${CODEX_EMPTY:-}" ]; then
  [ -n "${CODEX_NOISE:-}" ] && awk 'BEGIN { for (i = 0; i < 1000; i++) printf "%070d\n", i }'
  echo "ERROR: You've hit your usage limit. Try again later." >&2
  exit 1
fi
[ -n "${CODEX_GROUP:-}" ] && echo '{"units": []}' > "$(dirname "$out")/units.json"
if [ -n "$out" ]; then
  top=$(pwd -P)
  TOP="$top" awk '{ out = ""; s = $0; while ((i = index(s, "@top")) > 0) { out = out substr(s, 1, i - 1) ENVIRON["TOP"]; s = substr(s, i + 4) } print out s }' "$here/inputs/${CODEX_ANSWER:?a case names its answer}" > "$out"
fi
[ -n "${CODEX_LATE:-}" ] && pause
echo "codex stub: answered"
exit 0
