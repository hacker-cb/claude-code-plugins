#!/bin/sh
# Stands in for the `claude` CLI: prints the envelope the case names and nothing
# else, so the script under test parses a real result message without an engine, a
# network or an account behind it.
#
# Everything below is optional and driven by the case, so that a run's observable
# surface — the flags it was launched with, what it wrote to stderr, the boundary it
# was launched inside, how it exited — can be asserted instead of assumed.

# Proof that THIS answered, rather than some `claude` further down PATH.
[ -z "${STUB_MARKER_FILE:-}" ] || : > "$STUB_MARKER_FILE"
# The argv the script built, one argument per line, for cases that pin the flags.
[ -z "${STUB_ARGV_FILE:-}" ] || printf '%s\n' "$@" > "$STUB_ARGV_FILE"
# The prompt the run was launched with — `-p` and its value are the first two
# arguments — echoed where a case can assert what it says.
[ -z "${STUB_ECHO_PROMPT:-}" ] || echo "stub prompt: $2" >&2
# A warning on stderr, which the script collects into its `run warnings:` block.
[ -z "${STUB_STDERR:-}" ] || printf '%s\n' "$STUB_STDERR" >&2
# The CLI's own refusal of `--strict-mcp-config` under an enterprise MCP configuration,
# in its exact words, which no `NAME=value` case word could carry: they hold no spaces.
[ -z "${STUB_ENTERPRISE_MCP:-}" ] \
  || echo "You cannot use --strict-mcp-config when an enterprise MCP config is present" >&2
# The same words in passing, which a review of a repository that documents one writes
# on its way to a perfectly good report.
[ -z "${STUB_MENTIONS_MCP:-}" ] \
  || echo "note: this repository documents an enterprise MCP config of its own" >&2
# The read-only boundary the run was launched inside, judged against the checkout it
# runs in and reported on stderr like the warning above: writes denied to the tree,
# both git directories and the run's own output, a filesystem layer the repository
# cannot switch off, no way out of the sandbox, nothing approved outside it — an
# inherited allow rule included — and the file tools denied.
if [ -n "${STUB_CHECK_BOUNDARY:-}" ]; then
  settings="" mode="" allowed="" disallowed="" strict="" prev=""
  for arg in "$@"; do
    case "$prev" in
      --settings) settings=$arg ;;
      --permission-mode) mode=$arg ;;
      --allowedTools) allowed=$arg ;;
      --disallowedTools) disallowed=$arg ;;
    esac
    [ "$arg" = "--strict-mcp-config" ] && strict=1
    prev=$arg
  done
  broken=""
  printf '%s' "$settings" | jq -e \
      --arg top "$(git rev-parse --show-toplevel)" \
      --arg common "$(git rev-parse --path-format=absolute --git-common-dir)" \
      --arg gitdir "$(git rev-parse --absolute-git-dir)" \
      --arg tmp "$(cd "${TMPDIR:-/tmp}" && pwd -P)" '
    .disableAllHooks == true and (.sandbox as $s
    | ($s.filesystem.denyWrite // []) as $denied
    | [$denied[] | select(startswith($tmp + "/claude-review.") and (endswith(".log") | not))] as $out
    | $s.enabled == true and $s.failIfUnavailable == true
      and $s.allowUnsandboxedCommands == false and $s.filesystem.disabled == false
      and $s.autoAllowBashIfSandboxed == true and .env.GIT_OPTIONAL_LOCKS == "0"
      and ([$top, $common, $gitdir] - $denied | length == 0)
      and ($out | length == 1) and ($denied | index($out[0] + ".log") != null)
      and ((.permissions.ask // []) | index("Bash") != null))' \
      >/dev/null || broken="$broken settings"
  # The wrapper's own git reads happen before any of those settings apply, so what
  # holds them off the denied index lock is the variable it exported — visible here
  # because this stub inherits it, and only because the suite hands the run a
  # different value to start from.
  [ "${GIT_OPTIONAL_LOCKS:-}" = 0 ] || broken="$broken wrapper-git-env"
  [ "$mode" = dontAsk ] || broken="$broken permission-mode"
  [ -n "$strict" ] || broken="$broken mcp-servers"
  case ",$allowed," in *,Bash*) broken="$broken allowedTools" ;; esac
  for tool in Edit Write NotebookEdit; do
    case ",$disallowed," in *",$tool,"*) ;; *) broken="$broken disallowedTools:$tool" ;; esac
  done
  if [ -z "$broken" ]; then echo "stub: read-only boundary held" >&2
  else echo "stub: read-only boundary broken:$broken" >&2; fi
fi

[ -z "${STUB_ENVELOPE:-}" ] || cat "$STUB_ENVELOPE"
exit "${STUB_EXIT:-0}"
