#!/usr/bin/env bash
[ -n "${STUB_MARKER_FILE:-}" ] && touch "$STUB_MARKER_FILE"
env=${STUB_ENVELOPE:-}
ask() { [ -n "$env" ] && jq -r "$1 // empty" "$env"; }
case "$1" in
  repo)
    # A case can refuse the probe outright, which is how the other CLI gets its turn.
    case "$(ask '.gh_probe')" in fail) echo "gh: not a GitHub repository" >&2; exit 1 ;; esac
    # This command takes the repository POSITIONALLY — `--repo` is not a flag it has, and
    # passing one fails outright, which a case can require rather than assume.
    want=$(ask '.require_repo')
    if [ -n "$want" ]; then
      got=""; for a in "$@"; do case "$a" in */*) got=$a ;; esac; done
      [ "$got" = "$want" ] || { echo "gh: asked for '$got', wanted '$want'" >&2; exit 1; }
    fi
    v=$(ask '.repo_view')
    case "$v" in
      ""|fail) echo "gh: could not resolve to a Repository" >&2; exit 1 ;;
      *) printf '%s\n' "$v"; exit 0 ;;
    esac ;;
  api)
    # A case can require the host: passing the wrong one is otherwise silent, and a
    # self-hosted instance asked of the SaaS answers about somebody else or about
    # nothing. The stub's own stderr is swallowed by the caller, so the only way a case
    # can see this is the refusal.
    want=$(ask '.require_host')
    if [ -n "$want" ]; then
      prev="" got=""
      for a in "$@"; do [ "$prev" = "--hostname" ] && got=$a; prev=$a; done
      [ "$got" = "$want" ] || { echo "gh: asked $got, this instance is $want" >&2; exit 1; }
    fi
    # The path carries the tip, so an envelope can answer per commit.
    tip=""
    for a in "$@"; do
      case "$a" in
        repos/*/commits/*/pulls) tip=${a#*/commits/}; tip=${tip%/pulls} ;;
      esac
    done
    v=$(ask ".pulls[\"$tip\"] // .pulls_default")
    case "$v" in
      fail) echo "gh: HTTP 502" >&2; exit 1 ;;
      # What the real CLI prints for a commit no request carries: an empty LIST, not
      # nothing at all. Nothing at all is a call that brought no answer.
      none|"") printf '[]\n'; exit 0 ;;
      *) printf '%s\n' "$v"; exit 0 ;;
    esac ;;
esac
echo "stub gh: no envelope answer for: $*" >&2; exit 3
