#!/usr/bin/env bash
# The other forge, mirrored. Its `api --paginate` merges the pages into ONE array, which
# is the opposite of the sibling CLI — so the envelope holds one array here and one
# document per page there, and a reader written for either would fail on the other.
[ -n "${STUB_MARKER_FILE:-}" ] && : > "$STUB_MARKER_FILE"
env=${STUB_ENVELOPE:-}
ask() { [ -n "$env" ] && jq -r "$1 // empty" "$env"; }
case "$1" in
  api)
    tip=""
    for a in "$@"; do
      case "$a" in
        projects/*/repository/commits/*/merge_requests)
          tip=${a#*/commits/}; tip=${tip%/merge_requests} ;;
        projects/*) [ -z "$tip" ] && tip=PROBE ;;
      esac
    done
    if [ "$tip" = PROBE ]; then
      case "$(ask '.glab_probe')" in
        fail) echo "glab: not a GitLab repository" >&2; exit 1 ;;
        *) printf '{"id": 1}\n'; exit 0 ;;
      esac
    fi
    v=$(ask ".pulls[\"$tip\"] // .pulls_default")
    case "$v" in
      fail) echo "glab: 502" >&2; exit 1 ;;
      none|"") printf '[]\n'; exit 0 ;;
      *) printf '%s\n' "$v"; exit 0 ;;
    esac ;;
esac
echo "stub glab: no envelope answer for: $*" >&2; exit 3
