#!/usr/bin/env bash
# The other forge, mirrored. Its `api --paginate` may print the pages merged into ONE array,
# the opposite of the sibling CLI, or one array per page — so an envelope may hold either, and
# a reader written for one shape alone fails on the other.
[ -n "${STUB_MARKER_FILE:-}" ] && touch "$STUB_MARKER_FILE"
env=${STUB_ENVELOPE:-}
ask() { [ -n "$env" ] && jq -r "$1 // empty" "$env"; }
case "$1" in
  api)
    tip=""
    for a in "$@"; do
      case "$a" in
        projects/*/repository/commits/*/merge_requests)
          tip=${a#*/commits/}; tip=${tip%/merge_requests} ;;
        projects/*) [ -z "$tip" ] && tip=PROBE ;;
      esac
    done
    if [ "$tip" = PROBE ]; then
      # Answering is the case's to ask for, exactly as the sibling stub makes the GitHub
      # probe depend on `.repo_view`. A stub that answers by default made every case one
      # where BOTH CLIs answer — the ambiguity a mirror creates — and hid it behind
      # whichever the reader happened to try first.
      case "$(ask '.glab_probe')" in
        yes) printf '{"id": 1}\n'; exit 0 ;;
        *) echo "glab: not a GitLab repository" >&2; exit 1 ;;
      esac
    fi
    v=$(ask ".pulls[\"$tip\"] // .pulls_default")
    case "$v" in
      fail) echo "glab: 502" >&2; exit 1 ;;
      none|"") printf '[]\n'; exit 0 ;;
      *) printf '%s\n' "$v"; exit 0 ;;
    esac ;;
esac
echo "stub glab: no envelope answer for: $*" >&2; exit 3
