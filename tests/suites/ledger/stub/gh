#!/usr/bin/env bash
# Writes are kept beside the marker, which the runner removes before each case: its absence is
# this case's first call, and what an earlier case wrote is gone.
if [ -n "${STUB_MARKER_FILE:-}" ]; then
  [ -f "$STUB_MARKER_FILE" ] || rm -rf "$STUB_MARKER_FILE.store"
  : > "$STUB_MARKER_FILE"; mkdir -p "$STUB_MARKER_FILE.store"
fi
env=${STUB_ENVELOPE:-}
ask() { [ -n "$env" ] && jq -r "$1 // empty" "$env"; }

if [ "$1 $2" = "auth status" ]; then
  case "$(ask '.auth')" in
    glab|none) echo "not logged in" >&2; exit 1 ;;
    *) echo "logged in"; exit 0 ;;
  esac
fi

if [ "$1" = "api" ]; then
  store="${STUB_MARKER_FILE:-/dev/null}.store"
  method="" file="" prev=""
  for a in "$@"; do
    [ "$prev" = "--method" ] && method=$a
    [ "$prev" = "-F" ] && case "$a" in body=@*) file=${a#body=@} ;; esac
    prev=$a
  done
  # A write: kept, and answered the way the forge answers one. `.write_fail` breaks it —
  # `once` refuses the first write without keeping it, `landed` keeps it and refuses anyway,
  # `always` refuses every one.
  if [ -n "$method" ]; then
    [ -n "$file" ] || { echo "a write without -F body=@<file>" >&2; exit 1; }
    n=$(ls "$store" | grep -c '^w' || true); echo "$method $*" > "$store/w$n"
    fail=$(ask '.write_fail')
    case "$fail" in
      always) echo "$(basename "$0"): Bad Gateway (HTTP 502)" >&2; exit 1 ;;
      once) [ "$n" = 0 ] && { echo "$(basename "$0"): Bad Gateway (HTTP 502)" >&2; exit 1; } ;;
    esac
    last=""; for a in "$@"; do case "$a" in repos/*|projects/*) last=$a ;; esac; done
    case "$method" in POST) id=$((900 + n)) ;; *) id=${last##*/} ;; esac
    cp "$file" "$store/c$id"
    [ "$fail" = landed ] && [ "$n" = 0 ] && { echo "$(basename "$0"): Bad Gateway (HTTP 502)" >&2; exit 1; }
    jq -n --arg id "$id" --rawfile body "$file" '{id: ($id|tonumber), body: $body, html_url: ("https://forge.example/c/" + $id)}'
    exit 0
  fi
  # One comment read back by its id: what was written, where something was.
  for a in "$@"; do
    case "$a" in
      */issues/comments/*|*/notes/*)
        id=${a##*/}
        [ -f "$store/c$id" ] || { echo "$(basename "$0"): Not Found (HTTP 404)" >&2; exit 1; }
        [ "$(ask '.readback')" = garbled ] && { jq -n --arg id "$id" '{id: ($id|tonumber), body: "something else"}'; exit 0; }
        jq -n --arg id "$id" --rawfile body "$store/c$id" '{id: ($id|tonumber), body: $body, html_url: ("https://forge.example/c/" + $id)}'
        exit 0 ;;
    esac
  done
  # The host a call went to is a boundary the suite asserts: a run that dropped the flag would
  # read an unrelated repository of the same name on the SaaS and look correct doing it.
  host="" prev=""
  for a in "$@"; do [ "$prev" = "--hostname" ] && { host=$a; break; }; prev=$a; done
  want=$(ask '.want_host')
  [ "$want" = "$host" ] || { echo "that call went to '${host:-the default host}', not '$want'" >&2; exit 1; }

  # The run's own identity, which is a different question from whether a repository answers.
  # Each forge names the field itself — `login` here, `username` on the other — and the stub
  # answers with ONE of them, so a script reading the wrong field reads nothing.
  is_user=0
  for a in "$@"; do [ "$a" = user ] && is_user=1; done
  if [ "$is_user" = 1 ]; then
    v=$(ask '.me')
    case "$v" in
      ""|yes) echo '{"login":"example-user-00000001"}'; exit 0 ;;
      # A repository's own token and an App installation token both get 403 from this call.
      silent) echo "$(basename "$0"): Resource not accessible (HTTP 403)" >&2; exit 1 ;;
      notjson) echo 'not json at all'; exit 0 ;;
      *) printf '%s\n' "$v"; exit 0 ;;
    esac
  fi

  # The path, so a case can assert WHICH repository and issue were asked for.
  path=""
  for a in "$@"; do case "$a" in repos/*|projects/*) path=$a ;; esac; done
  case "$path" in
    */issues/*) ;;
    *) v=$(ask '.probe_gh')
       case "$v" in
         ""|yes) echo '{"full_name":"team/app"}'; exit 0 ;;
         *) echo "no such repository here" >&2; exit 1 ;;
       esac ;;
  esac

  want_path=$(ask '.want_path')
  if [ -n "$want_path" ]; then
    [ "$path" = "$want_path" ] || { echo "asked for '$path', not '$want_path'" >&2; exit 1; }
  fi


  # `--paginate` is what walks the feed to its end; a run that dropped it would read page one
  # and call it the list.
  case " $* " in *" --paginate "*) ;; *) echo "the feed was read unpaginated" >&2; exit 1 ;; esac

  v=$(ask '.comments')
  case "$v" in
    ""|silent) echo "could not read the comment feed" >&2; exit 1 ;;
    notfound) echo "$(basename "$0"): Not Found (HTTP 404)" >&2; exit 1 ;;
    # A paginated walk prints the pages it DID get before dying on a later one, and an epic
    # discussing a forge's 404s carries those words in a comment body.
    halfway) printf '%s\n' '[{"id":1,"body":"the forge answered 404 Not Found here"}]'
             echo "$(basename "$0"): Bad Gateway (HTTP 502)" >&2; exit 1 ;;
    noproject) echo "$(basename "$0"): 404 Project Not Found (HTTP 404)" >&2; exit 1 ;;
    *) printf '%s\n' "$v"; exit 0 ;;
  esac
fi
echo "unplanned gh call: $*" >&2; exit 1
