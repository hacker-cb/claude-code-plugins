#!/usr/bin/env bash
# A forge keeping its labels in $STUB_STATE: { set: [{name, id, color, description}], carriers:
# {"issue 1": [names], "request 2": [names]}, fail: [{method, match, landed}], log: [] }. A `fail`
# entry is spent by the first write whose method and endpoint it matches: it answers HTTP 422, the
# write landing first where `landed` says so. GitHub reads names without regard to case.
me=${STUB_AS:-$(basename "$0")}
st=${STUB_STATE:?}
[ -n "${STUB_MARKER_FILE:-}" ] && : > "$STUB_MARKER_FILE"
put() { jq "$@" "$st" > "$st.tmp" && mv "$st.tmp" "$st"; }
if [ "$me" = gh ] && [ "$1 $2" = "repo view" ]; then
  echo '{"url":"https://forge.example/team/app","nameWithOwner":"team/app"}'; exit 0
fi
[ "$1" = api ] || { echo "unplanned $me call: $*" >&2; exit 1; }
shift
method=GET endpoint="" input="" label="" query="" prev=""
for a in "$@"; do
  case "$prev" in --method) method=$a ;; --input) input=$a ;; -f) case "$a" in label=*) label=${a#label=} ;; query=*) query=${a#query=} ;; esac ;; esac
  case "$a" in repos/*|projects/*|graphql) endpoint=$a ;; esac
  prev=$a
done
if [ "$me" = glab ] && { [ "$endpoint" = "projects/:fullpath" ] || [ "$endpoint" = "projects/team%2Fapp" ]; }; then
  echo '{"web_url":"https://lab.example/team/app","path_with_namespace":"team/app"}'; exit 0
fi
dec() { local s=${1//+/ }; printf '%b' "${s//%/\\x}"; }
fold() { if [ "$me" = gh ]; then printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; else printf '%s' "$1"; fi; }
ci=$([ "$me" = gh ] && echo true || echo false)
# jq: does a name match another, by this forge's rule
M='def same($a; $b): if $ci then ($a|ascii_downcase) == ($b|ascii_downcase) else $a == $b end;'
body() { [ -n "$input" ] && cat "$input" || echo null; }

if [ "$method" != GET ]; then
  put --arg e "$method $endpoint" --argjson b "$(body)" '.log += [$e + (if $b == null then "" else " " + ($b|tojson) end)]'
  f=$(jq -c --arg m "$method" --arg e "$endpoint" 'first((.fail // []) | to_entries[] | select(.value as $f | $f.method == $m and ($e | contains($f.match)))) // empty' "$st")
  if [ -n "$f" ]; then
    put --argjson k "$(jq '.key' <<<"$f")" 'del(.fail[$k])'
    [ "$(jq -r '.value.landed' <<<"$f")" = true ] || { echo "$me: Unprocessable Entity (HTTP 422)" >&2; exit 1; }
    landed_fail=1
  fi
fi
finish() { if [ -n "${landed_fail:-}" ]; then echo "$me: Unprocessable Entity (HTTP 422)" >&2; exit 1; fi; exit 0; }

case "$me $method $endpoint" in
  "gh GET repos/team/app")
    jq -c '{default_branch: "main", has_discussions: (.discussions != null)}' "$st" ;;
  "gh GET graphql"|"glab GET graphql")
    [ "$(jq -r '.graphql_error // false' "$st")" = true ] && { echo '{"errors":[{"message":"Something went wrong"}],"data":{"repository":{"label":null}}}'; exit 0; }
    # A number looked up: GitHub's issueOrPullRequest, GitLab's iids.
    if [[ $query == *"issueOrPullRequest(number:"* ]]; then
      n=${query#*number:}; n=${n%%)*}
      jq -c --arg n "$n" 'if .carriers["issue " + $n] or .carriers["request " + $n] then {data: {repository: {issueOrPullRequest: {__typename: "Issue"}}}}
        else {data: {repository: {issueOrPullRequest: null}}, errors: [{type: "NOT_FOUND"}]} end' "$st"; exit 0
    fi
    if [[ $query == *"(iids:"* ]]; then
      n=${query#*iids:[\"}; n=${n%%\"*}
      if [[ $query == *workItems* ]]; then kind=issue f=workItems; else kind=request f=mergeRequests; fi
      jq -c --arg k "$kind $n" --arg f "$f" '{data: {project: {($f): {nodes: (if .carriers[$k] then [{iid: ($k | split(" ")[1])}] else [] end)}}}}' "$st"; exit 0
    fi
    # GitLab: how many work items and requests hold a label.
    if [ "$me" = glab ]; then
      jq -c --arg l "$label" '[.carriers | to_entries[] | select(.value | index($l)) | .key | split(" ")[0]] as $k
        | {data: {project: {workItems: {count: ($k | map(select(. == "issue")) | length)}, mergeRequests: {count: ($k | map(select(. == "request")) | length)}}}}' "$st"
      exit 0
    fi
    if [[ $query == *"discussions(first"* ]]; then
      jq -c '{data: {repository: {discussions: {totalCount: ((.discussions | length) + (.discussions_unread // 0)), pageInfo: {hasNextPage: false, endCursor: null},
        nodes: [.discussions | to_entries[] | {number: (.key + 1), labels: {totalCount: (.value | length), nodes: [.value[] | {name: .}]}}]}}}}' "$st"
      exit 0
    fi
    jq -c --arg l "$label" --argjson ci "$ci" "$M"'
      if any(.set[]; same(.name; $l)) then
        [.carriers | to_entries[] | select(any(.value[]; same(.; $l))) | .key | split(" ")[0]] as $k
        | {data: {repository: {label: {issues: {totalCount: ($k | map(select(. == "issue")) | length)},
            pullRequests: {totalCount: ($k | map(select(. == "request")) | length)}}}}}
      else {data: {repository: {label: null}}} end' "$st" ;;
  "gh GET repos/team/app/labels?"*)
    jq -c '[.set[] | {name, id, color, description}]' "$st" ;;
  "glab GET projects/team%2Fapp/labels?"*)
    jq -c '[.set[] | {name, id, color: ("#" + .color), description, is_project_label: true}]' "$st" ;;
  "gh POST repos/team/app/labels"|"glab POST projects/team%2Fapp/labels")
    jq -e --argjson b "$(body)" --argjson ci "$ci" "$M"'any(.set[]; same(.name; $b.name))' "$st" >/dev/null \
      && { echo "$me: Validation Failed (HTTP 422)" >&2; exit 1; }
    put --argjson b "$(body)" '.set += [{name: $b.name, id: ((.set | map(.id) | max // 0) + 1), color: ($b.color | ltrimstr("#")), description: $b.description}]'
    finish ;;
  "gh PATCH repos/team/app/labels/"*|"glab PUT projects/team%2Fapp/labels/"*|"gh DELETE repos/team/app/labels/"*|"glab DELETE projects/team%2Fapp/labels/"*)
    key=$(dec "${endpoint##*/}")
    if [ "$me" = gh ]; then sel='same(.name; $k)'; else sel='(.id | tostring) == $k'; fi
    jq -e --arg k "$key" --argjson ci "$ci" "$M"'any(.set[]; '"$sel"')' "$st" >/dev/null || { echo "$me: Not Found (HTTP 404)" >&2; exit 1; }
    old=$(jq -r --arg k "$key" --argjson ci "$ci" "$M"'first(.set[] | select('"$sel"')) | .name' "$st")
    if [ "$method" = DELETE ]; then
      put --arg o "$old" '.set |= map(select(.name != $o)) | .carriers |= map_values(map(select(. != $o)))'
    else
      put --arg o "$old" --argjson b "$(body)" '
        ($b.new_name // $o) as $n
        | .set |= map(if .name == $o then .name = $n
            | (if $b.color then .color = ($b.color | ltrimstr("#")) else . end)
            | (if $b | has("description") then .description = $b.description else . end) else . end)
        | .carriers |= map_values(map(if . == $o then $n else . end))'
    fi
    finish ;;
  "gh GET repos/team/app/issues/"*)
    n=${endpoint##*/}
    # `move_on_read`: another hand changes this carrier just before its next read.
    put --arg n "$n" 'if .move_on_read and (.move_on_read.carrier | endswith(" " + $n)) then
        .move_on_read.reads += 1 | if .move_on_read.reads == 2 then .carriers[.move_on_read.carrier] = .move_on_read.labels else . end else . end'
    jq -c --arg n "$n" 'if .carriers["issue " + $n] then {labels: [.carriers["issue " + $n][] | {name: .}]}
      elif .carriers["request " + $n] then {labels: [.carriers["request " + $n][] | {name: .}], pull_request: {}}
      else error("none") end' "$st" 2>/dev/null || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; } ;;
  "gh DELETE repos/team/app/issues/"*"/labels/"*)
    rest=${endpoint#repos/team/app/issues/}; n=${rest%%/*}; name=$(dec "${endpoint##*/}")
    k=$(jq -r --arg n "$n" 'if .carriers["issue " + $n] then "issue " + $n else "request " + $n end' "$st")
    put --arg k "$k" --arg l "$name" --argjson ci "$ci" "$M"'.carriers[$k] |= map(select(same(.; $l) | not))'
    finish ;;
  "gh POST repos/team/app/issues/"*"/labels")
    rest=${endpoint#repos/team/app/issues/}; n=${rest%%/*}
    k=$(jq -r --arg n "$n" 'if .carriers["issue " + $n] then "issue " + $n else "request " + $n end' "$st")
    put --arg k "$k" --argjson b "$(body)" '(.drop_on_add // null) as $d | .carriers[$k] += $b.labels | .carriers[$k] |= (unique - [$d | values])'
    finish ;;
  "glab GET projects/team%2Fapp/issues/"*|"glab GET projects/team%2Fapp/merge_requests/"*)
    kind=$([[ $endpoint == */issues/* ]] && echo issue || echo request); n=${endpoint##*/}
    # `rest_hidden` names carriers REST does not reach — a work item type outside issues and tasks.
    jq -c --arg k "$kind $n" 'if .carriers[$k] and ((.rest_hidden // []) | index($k) | not) then {labels: .carriers[$k]} else error("none") end' "$st" 2>/dev/null \
      || { echo "glab: 404 Not Found (HTTP 404)" >&2; exit 1; } ;;
  "glab PUT projects/team%2Fapp/issues/"*|"glab PUT projects/team%2Fapp/merge_requests/"*)
    kind=$([[ $endpoint == */issues/* ]] && echo issue || echo request); n=${endpoint##*/}
    put --arg k "$kind $n" --argjson b "$(body)" '
      (($b.remove_labels // "") | split(",")) as $r | (($b.add_labels // "") | split(",") | map(select(. != ""))) as $a
      | .carriers[$k] |= ((map(select(. as $x | $r | index($x) | not)) + $a) | unique)'
    finish ;;
  *) echo "unplanned $me api call: $method $endpoint" >&2; exit 1 ;;
esac
